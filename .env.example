# cookie 文件路径（默认 ~/.goofish-cli/cookies.json）
GOOFISH_COOKIES_PATH=~/.goofish-cli/cookies.json

# 写操作限流：每分钟允许次数（默认 1，防风控）
GOOFISH_WRITE_RPM=1

# 风控熔断时长（分钟）
GOOFISH_CIRCUIT_BREAK_MINUTES=10

# 日志等级
GOOFISH_LOG_LEVEL=INFO

# 消息桥：密钥只写入本地 .env；不得提交实际值。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
OPEN_ID=

# 仅未启用比特来源且 network.mode=proxy 时使用；启用比特后直接读取窗口，无需填写。
# 示例格式：http://用户名:密码@地址:端口（特殊字符需 URL 编码）。
GOOFISH_A1_PROXY_URL=
GOOFISH_A2_PROXY_URL=
GOOFISH_A3_PROXY_URL=
